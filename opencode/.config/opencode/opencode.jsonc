{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    // { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "deny" },
    { "action": "shell", "resource": "git stage *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "sudo rm *", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "shred *", "effect": "deny" },
    { "action": "shell", "resource": "chmod -R 777 *", "effect": "deny" },
    { "action": "shell", "resource": "> /dev/*", "effect": "deny" },
  ],
  "plugins": ["opencodev2-cursor", "opencode-antigravity-auth"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": ["playwright-mcp"], // Install via `npm i -g @playwright/mcp@latest`
        "timeout": {
          "catalog": 60000,
          "execution": 60000,
        },
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["chrome-devtools-mcp"], // Install via `npm i -g chrome-devtools-mcp@latest`
        "timeout": {
          "catalog": 60000,
          "execution": 60000,
        },
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": true,
        "timeout": {
          "catalog": 600000,
          "execution": 600000,
        },
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        },
        "timeout": {
          "catalog": 600000,
          "execution": 600000,
        },
      },
      "study-score": {
        "type": "remote",
        "url": "https://studyscore.app/api/v1/mcp",
      },
    },
  },
}
