{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git *": "allow",
      "git add *": "deny",
      "git stage *": "deny",
      "git reset *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "git branch -D": "deny",
      "git tag -d *": "deny",
      "git rebase *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "rm -r *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo rm *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "shred *": "deny",
      "chmod -R 777 *": "deny",
      "> /dev/*": "deny",
    },
    "external_directory": {
      "$HOME/git/**": "allow",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 60000,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "timeout": 60000,
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false,
      "timeout": 600000,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
      "enabled": true,
      "timeout": 600000,
    },
  },
  "lsp": true,
}
