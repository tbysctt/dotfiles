{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git *": "allow",
      "git add *": "deny",
      "git stage *": "deny",
      "git reset *": "deny",
      "git commit *": "deny",
    },
    "external_directory": {
      "$HOME/git/**": "allow",
    },
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": false,
      "timeout": 600000,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
      "enabled": false,
      "timeout": 600000,
    },
  },
  "lsp": true,
}
